{
  "name": "@journey-to-code/symbology",
  "version": "0.2.0",
  "description": "Dependency-free QR and linear barcode encoding and decoding in Rust, JavaScript, and a Zubra web component",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/journey-to-code-org/symbology.git",
    "directory": "js"
  },
  "keywords": [
    "qr",
    "barcode",
    "symbology",
    "webassembly",
    "web-component",
    "zubra"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./qr.d.ts",
      "import": "./qr.js"
    },
    "./symbology-code": {
      "types": "./dist/symbology-code.d.ts",
      "import": "./dist/symbology-code.js"
    },
    "./symbology.wasm": "./symbology.wasm"
  },
  "types": "./qr.d.ts",
  "files": [
    "qr.js",
    "qr.d.ts",
    "symbology.wasm",
    "dist/",
    "components/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test --test-concurrency=1 'test/*.test.js'"
  },
  "devDependencies": {
    "@zubra/compiler": "5.9.2",
    "playwright-core": "^1.65.0"
  }
}
